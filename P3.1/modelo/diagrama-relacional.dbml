Project los_postres_de_malu {
  database_type: 'PostgreSQL'
  Note: 'Propuesta derivada del modelo EER. Solo documentación: no conecta el sitio con una base de datos.'
}

Enum tipo_cuenta {
  cliente
  personal
}

Enum rol_personal {
  empleado
  administrador
}

Enum estado_pedido {
  solicitado
  confirmado
  en_preparacion
  listo
  entregado
  cancelado
}

Enum tipo_movimiento {
  entrada
  salida
}

Table usuario {
  id_usuario integer [pk, increment]
  nombre_usuario varchar(50) [not null, unique]
  contrasena_hash text [not null, note: 'Hash futuro; este archivo no contiene contraseñas ni datos de acceso.']
  tipo_cuenta tipo_cuenta [not null]
  Note: 'Especialización total y disjunta: exactamente una fila en cuenta_cliente o cuenta_personal, según tipo_cuenta. Se debe imponer aparte de las FK.'
}

Table cuenta_cliente {
  id_usuario integer [pk, not null, ref: - usuario.id_usuario]
  id_cliente integer [not null, unique, ref: - cliente.id_cliente]
  Note: 'El cliente puede existir sin cuenta. Una cuenta_cliente pertenece a exactamente un cliente.'
}

Table cuenta_personal {
  id_usuario integer [pk, not null, ref: - usuario.id_usuario]
  rol rol_personal [not null]
}

Table cliente {
  id_cliente integer [pk, increment]
  nombre varchar(100) [not null]
  telefono varchar(20) [not null]
  direccion text
}

Table pedido {
  id_pedido integer [pk, increment]
  id_cliente integer [not null, ref: > cliente.id_cliente]
  fecha_pedido timestamp [not null]
  fecha_entrega timestamp [not null]
  estado estado_pedido [not null, default: 'solicitado']
  Note: 'Debe tener al menos un detalle. Total derivado: SUM(detalle_pedido.cantidad * detalle_pedido.precio_unitario). Las ventas son pedidos en estado entregado.'
}

Table detalle_pedido {
  id_pedido integer [not null, ref: > pedido.id_pedido]
  nro_renglon integer [not null, note: 'Clave parcial; entero positivo único dentro del pedido.']
  id_producto integer [not null, ref: > producto.id_producto]
  cantidad integer [not null, note: 'Mayor que cero.']
  precio_unitario decimal(10,2) [not null, note: 'No negativo; precio acordado en ese pedido, incluida su cotización.']
  personalizacion text
  indexes {
    (id_pedido, nro_renglon) [pk]
  }
  Note: 'Entidad débil de Pedido. No existe id_detalle global. El mismo producto puede aparecer en renglones distintos con personalizaciones diferentes.'
}

Table producto {
  id_producto integer [pk, increment]
  nombre varchar(100) [not null]
  descripcion text
  categoria varchar(50) [not null]
  precio_base decimal(10,2) [not null, note: 'No negativo.']
  disponible boolean [not null, default: true]
  imagen text [note: 'Ruta o URL pública de una imagen; nunca un dato de acceso.']
}

Table inventario {
  id_inventario integer [pk, increment]
  id_producto integer [not null, unique, ref: - producto.id_producto]
  cantidad_disponible integer [not null, default: 0, note: 'No negativa; productos terminados.']
  fecha_actualizacion timestamp [not null]
  Note: 'Relación de negocio 1:1. La FK y UQ impiden varios inventarios por producto; crear todo producto con su inventario requiere una regla adicional.'
}

Table movimiento_inventario {
  id_inventario integer [not null, ref: > inventario.id_inventario]
  nro_movimiento integer [not null, note: 'Clave parcial; entero positivo único dentro del inventario.']
  fecha timestamp [not null]
  tipo tipo_movimiento [not null]
  cantidad integer [not null, note: 'Mayor que cero; tipo determina si suma o resta.']
  motivo text
  indexes {
    (id_inventario, nro_movimiento) [pk]
  }
  Note: 'Entidad débil de Inventario. Registrar movimientos y actualizar existencias deberá hacerse en la misma transacción cuando exista backend.'
}
